# Overlay first. Do not reorder these relative to each other.
RULE-SET,<base>/config/Surge/Infrastructure/CloudflareTunnel.list,DIRECT
RULE-SET,<base>/config/Surge/Tailscale/Coordination.list,Others
#!MACOS-ONLY RULE-SET,<base>/config/Surge/Tailscale/Tailnet.list,DIRECT
#!IOS-ONLY RULE-SET,<base>/config/Surge/Tailscale/Tailnet.list,Tailnet
RULE-SET,<base>/config/Surge/Tailscale/Direct.list,DIRECT
AND,((PROTOCOL,UDP),(DEST-PORT,3478)),DIRECT
RULE-SET,<base>/config/Surge/Apple/ApplePush.list,DIRECT
RULE-SET,<base>/config/Surge/Apple/iCloudContent.list,DIRECT
RULE-SET,<base>/config/Surge/Apple/AppleIntelligence.list,AI Suite
RULE-SET,<base>/config/Surge/Rescue/Douyin.list,Domestic
RULE-SET,<base>/config/Surge/Rescue/Meituan.list,Domestic
RULE-SET,<base>/config/Surge/Rescue/Kuaishou.list,Domestic
RULE-SET,<base>/config/Surge/Rescue/BlockedDirect.list,Proxy
RULE-SET,<base>/config/Surge/AI/AI.list,AI Suite,extended-matching
RULE-SET,<base>/config/Surge/GitHub/GitHub.list,🇯🇵 JP

# Library. Process names, then reject, then services, then GEOIP, then IPs.
RULE-SET,<base>/config/Surge/Library/Process/ProxyCores.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Process/Downloaders.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Direct/Private.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Geo/LAN.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Reject/HttpDNS.list,REJECT
RULE-SET,<base>/config/Surge/Library/Reject/Ads.list,REJECT
RULE-SET,<base>/config/Surge/Library/Direct/NTP.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Direct/Speedtest.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Direct/Download.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Direct/CDNChina.list,DIRECT
RULE-SET,<base>/config/Surge/Library/Social/Telegram.list,Proxy
RULE-SET,<base>/config/Surge/Library/Social/Discord.list,Proxy
RULE-SET,<base>/config/Surge/Library/Social/X.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/Netflix.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/YouTube.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/Disney.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/Spotify.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/TikTok.list,Proxy
RULE-SET,<base>/config/Surge/Library/Media/China.list,Domestic
RULE-SET,<base>/config/Surge/Library/Gaming/Steam.list,Proxy
RULE-SET,<base>/config/Surge/Library/Platforms/ByteDance.list,Domestic
RULE-SET,<base>/config/Surge/Library/Platforms/Tencent.list,Domestic
RULE-SET,<base>/config/Surge/Library/Platforms/Alibaba.list,Domestic
RULE-SET,<base>/config/Surge/Library/Geo/TelegramCIDR.list,Proxy
GEOIP,CN,Domestic
RULE-SET,LAN,DIRECT
FINAL,Proxy,dns-failed
